# Server-side configuration for reference routes. Never expose these keys through NEXT_PUBLIC_*.
# Server-only key for POST /api/autopilot/parse. Either provider works; Anthropic wins when both are set.
ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint instead: OpenAI itself, a gateway, or a local server.
# A ChatGPT subscription does not work here; this needs an API key from platform.openai.com.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   (Ollama: http://localhost:11434/v1)
# KOUL_PARSER=openai
# Server-only sponsor secret for Funds and Circle faucet landing accounts.
KEEPER_SECRET=
# Optional local transfer record directory (contains SEP bearer tokens).
# FUNDS_STATE_DIR=
# Optional private Circle faucet transfer directory (contains pre-authorized XDR).
# FAUCET_STATE_DIR=
# Optional model override; defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=
# Optional overrides (defaults are the live testnet deployment)
# NEXT_PUBLIC_KOUL_ROUTER=
# NEXT_PUBLIC_KOUL_POLICY=
# NEXT_PUBLIC_KOUL_ORACLE=
# NEXT_PUBLIC_KOUL_AGENT_PUBLIC_KEY=
# Optional URL for the separate oracle admin app (defaults to http://localhost:3100/oracle).
# NEXT_PUBLIC_ORACLE_ADMIN_URL=
# Waitlist, read at build time: open = the landing collects emails and the app stays open to anyone;
# closed = the app also needs an invite. Unset = no waitlist.
# NEXT_PUBLIC_KOUL_WAITLIST=open
# Server-only invite codes, comma-separated: app.koul.me/?invite=<code> lets a browser in for 90 days.
# Remove a code to revoke it. Make new ones with: pnpm invite-codes <count> [prefix]
# KOUL_INVITE_CODES=
# Upstash Redis for POST /api/waitlist, set by the Vercel Marketplace integration (or UPSTASH_REDIS_REST_URL/TOKEN).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Waitlist emails through Resend (set by the Vercel Marketplace integration). Without the key no mail is sent.
# RESEND_API_KEY=
# Who gets a notice for each new signup.
# WAITLIST_NOTIFY_TO=
# Optional sender; defaults to Koul <hello@koul.me>.
# WAITLIST_FROM=
# Signs Approve links and personal invite cookies. Without it there are no Approve links and only env codes work.
# WAITLIST_SECRET=
# Optional link bases for the emails; default https://koul.me and https://app.koul.me.
# WAITLIST_BASE_URL=
# WAITLIST_APP_URL=
